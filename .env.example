APP_NAME=Private AI Lab
ENVIRONMENT=local
API_KEY=change-me-before-sharing

DATABASE_URL=postgresql+psycopg://private_ai:private_ai@postgres:5432/private_ai
INIT_DB_ON_STARTUP=true

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=15
MAX_CHUNK_TOKENS=260
CHUNK_OVERLAP_TOKENS=40
RAG_TOP_K=4

# hash works offline and is deterministic. Set to openai for a real embedding API.
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=384
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=text-embedding-3-small

# Ollama exposes an OpenAI-compatible /v1 API in recent versions.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:3b

LOG_LEVEL=INFO
